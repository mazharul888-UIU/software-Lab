{
  "name": "careercube",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/src/app.js",
    "dev:all": "concurrently -n WEB,API -c blue,green \"npm run dev\" \"npm run dev:api\"",
    "admin:create": "node server/src/scripts/create-admin.js",
    "db:setup": "node server/src/scripts/setup-database.js",
    "build": "npm run build:web && node scripts/prepare-sites.cjs",
    "build:web": "vite build",
    "test:navigation": "node scripts/navigation-smoke.mjs public && node scripts/navigation-smoke.mjs signup && node scripts/navigation-smoke.mjs login-student && node scripts/navigation-smoke.mjs login-admin && node scripts/navigation-smoke.mjs guard-student && node scripts/navigation-smoke.mjs guard-admin && node scripts/navigation-smoke.mjs student && node scripts/navigation-smoke.mjs brand",
    "test:student-section": "node scripts/student-section-smoke.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:adaptive-assessment": "node scripts/adaptive-assessment-smoke.cjs",
    "test:adaptive-ui": "node scripts/adaptive-assessment-ui-smoke.mjs",
    "test:student-overview": "node scripts/student-overview-smoke.cjs",
    "test:job-matching": "node scripts/job-matching-smoke.cjs",
    "test:verified-source-jobs": "node scripts/verified-source-jobs-smoke.cjs",
    "test:events": "node scripts/events-smoke.cjs",
    "test:community-posts": "node scripts/community-posts-smoke.cjs",
    "test:student-network": "node scripts/student-network-smoke.cjs",
    "test:social-profile": "node scripts/social-profile-smoke.cjs",
    "test:email-verification": "node scripts/email-verification-smoke.cjs",
    "preview": "vite preview",
    "start:api": "node server/src/app.js",
    "start": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.2"
  }
}
